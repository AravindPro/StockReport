# Copy this file to .env and add your OpenRouter API key.
OPEN_ROUTER_API=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# SMTP email forwarding (use an app password where your provider requires it).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@example.com
EMAIL_TO=recipient@example.com
EMAIL_USE_TLS=true
# Set true only for implicit-SSL SMTP, usually port 465. TLS and SSL are exclusive.
EMAIL_USE_SSL=false

# Telegram bot forwarding (obtain a bot token from @BotFather and a chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
